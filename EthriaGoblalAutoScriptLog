DO $$
DECLARE
    r RECORD;
    v_sql TEXT;
BEGIN
    FOR r IN
        SELECT tablename
        FROM pg_tables
        WHERE schemaname = 'public' --verificar estos datos antes de ejecutar el escript
        AND tablename NOT IN ( --tablas que son estaticas y no ocupan logs
            'logs',
            'tablas',
            'acciones',
            'permisosxrole',
            'permisos',
            'estadosordenes'
        )
    LOOP

        -- Verificar si el trigger ya existe
        IF NOT EXISTS (
            SELECT 1
            FROM pg_trigger
            WHERE tgname = 'trg_logs_' || r.tablename
        ) THEN

            v_sql := format(
                'CREATE TRIGGER trg_logs_%I
                 AFTER INSERT OR UPDATE OR DELETE ON %I
                 FOR EACH ROW
                 EXECUTE FUNCTION fn_log_generic();',
                r.tablename,
                r.tablename
            );

            EXECUTE v_sql;

        END IF;

    END LOOP;
END;
$$;